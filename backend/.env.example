# Copy to backend/.env to override defaults. Everything is optional; the demo runs without it.

# Local Hardhat node started by `npm run dev`.
DAOGUARD_RPC_URL=http://127.0.0.1:8545

# Optional: enable Claude interpretation of proposal documents. Without a key the brief is a
# clearly labelled deterministic extraction. Amounts, manifests and execution never use the model.
# ANTHROPIC_API_KEY=
# DAOGUARD_AI_MODEL=claude-opus-5-5

# Governance timing on the local chain (blocks).
DAOGUARD_REVIEW_WINDOW_BLOCKS=5
DAOGUARD_VOTING_PERIOD_BLOCKS=24
DAOGUARD_QUORUM_PERCENT=4

# Sentinel polling interval (seconds) for ManifestApproved events.
DAOGUARD_SENTINEL_POLL_SECONDS=1.5
